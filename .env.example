HOST=127.0.0.1
PORT=3000
# npm run dev defaults to http://localhost:5173; explicit PUBLIC_ORIGIN is honored.
# For LAN development, set PUBLIC_ORIGIN=http://<PC-LAN-IP>:5173 and DEV_HOST=0.0.0.0.
# DEV_PORT defaults to 5173. Backend remains on HOST/PORT above.
# Compiled local demo defaults to http://localhost:3000.
# Production requires an exact HTTPS PUBLIC_ORIGIN and NODE_ENV=production.
